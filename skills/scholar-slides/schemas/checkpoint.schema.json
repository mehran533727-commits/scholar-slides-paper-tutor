{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "fileEntry": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "requires": {
      "type": "object",
      "required": ["checkpoint", "record_path", "sha256"],
      "properties": {
        "checkpoint": {"enum": ["CKPT-1", "CKPT-2"]},
        "record_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint",
    "status",
    "created_at",
    "artifact",
    "artifact_bundle",
    "integrity_markers",
    "integrity_marker_locations"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "checkpoint": {"enum": ["CKPT-1", "CKPT-2", "CKPT-3"]},
    "status": {"enum": ["pending", "pending_human_confirmation", "approved", "confirmed"]},
    "created_at": {"type": "string", "minLength": 1},
    "artifact": {"$ref": "#/$defs/fileEntry"},
    "artifact_bundle": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fileEntry"}
    },
    "integrity_markers": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "integrity_marker_locations": {"type": "array"},
    "requires": {"$ref": "#/$defs/requires"},
    "review_bundle": {"$ref": "#/$defs/fileEntry"},
    "review_readiness": {
      "type": "object",
      "required": ["status", "manifest_sha256"],
      "properties": {
        "status": {"const": "ready_for_human_approval"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "approved_at": {"type": "string", "minLength": 1},
    "confirmed_at": {"type": "string", "minLength": 1},
    "confirmed_by": {"type": "string", "minLength": 1},
    "intended_confirmer": {"type": "string", "minLength": 1},
    "prepared_by": {
      "type": "object",
      "required": ["kind", "name"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "agent"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "asset_graph": {"$ref": "#/$defs/fileEntry"},
    "supplemental_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fileEntry"}
    },
    "inherited_marker_ledger": {"type": "object"},
    "readiness_artifact": {"$ref": "#/$defs/fileEntry"},
    "approval_bindings": {
      "type": "object",
      "required": [
        "source_pdf_sha256",
        "digest_sha256",
        "project_options_sha256",
        "review_json_sha256",
        "review_markdown_sha256",
        "marker_ledger_sha256",
        "readiness_sha256",
        "evidence_audit_sha256",
        "candidate_sha256"
      ]
    },
    "supersedes": {
      "type": "object",
      "required": ["revision_id", "checkpoint_sha256", "history_manifest_sha256"],
      "properties": {
        "revision_id": {"type": "string", "minLength": 1},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "history_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"checkpoint": {"const": "CKPT-1"}}, "required": ["checkpoint"]},
      "then": {
        "properties": {"status": {"enum": ["pending", "pending_human_confirmation", "confirmed"]}},
        "not": {"anyOf": [{"required": ["requires"]}, {"required": ["review_bundle"]}, {"required": ["review_readiness"]}, {"required": ["asset_graph"]}, {"required": ["supersedes"]}]}
      }
    },
    {
      "if": {"properties": {"checkpoint": {"const": "CKPT-2"}}, "required": ["checkpoint"]},
      "then": {
        "required": ["requires", "asset_graph", "supplemental_artifacts", "inherited_marker_ledger"],
        "properties": {
          "status": {"enum": ["pending", "approved"]},
          "requires": {"properties": {"checkpoint": {"const": "CKPT-1"}}}
        },
        "allOf": [
          {"if": {"required": ["review_bundle"]}, "then": {"required": ["review_readiness"]}},
          {"if": {"required": ["review_readiness"]}, "then": {"required": ["review_bundle"]}}
        ]
      }
    },
    {
      "if": {"properties": {"checkpoint": {"const": "CKPT-3"}}, "required": ["checkpoint"]},
      "then": {
        "required": ["requires", "review_bundle"],
        "properties": {
          "status": {"enum": ["pending", "approved"]},
          "requires": {"properties": {"checkpoint": {"const": "CKPT-2"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "pending_human_confirmation"}}, "required": ["status"]},
      "then": {
        "properties": {"checkpoint": {"const": "CKPT-1"}},
        "oneOf": [
          {"required": ["intended_confirmer"], "not": {"required": ["prepared_by"]}},
          {"required": ["prepared_by"], "not": {"required": ["intended_confirmer"]}}
        ]
      }
    },
    {
      "if": {"properties": {"status": {"const": "confirmed"}}, "required": ["status"]},
      "then": {
        "required": ["confirmed_at", "confirmed_by"],
        "properties": {"checkpoint": {"const": "CKPT-1"}},
        "not": {"anyOf": [{"required": ["approved_at"]}, {"required": ["intended_confirmer"]}, {"required": ["prepared_by"]}]}
      }
    },
    {
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {
        "required": ["approved_at", "confirmed_by", "review_bundle"],
        "properties": {"checkpoint": {"enum": ["CKPT-2", "CKPT-3"]}},
        "allOf": [
          {
            "if": {"properties": {"checkpoint": {"const": "CKPT-2"}}, "required": ["checkpoint"]},
            "then": {"required": ["review_readiness"]}
          }
        ]
      }
    },
    {
      "if": {"required": ["supersedes"]},
      "then": {"properties": {"checkpoint": {"const": "CKPT-2"}}}
    }
  ]
}
